# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/

# Claude Code local settings (machine-specific paths)
.claude/settings.local.json

# Symlink to a local data archive — absolute path, meaningless on any other
# machine. Point it at your own data:  ln -s /path/to/captures example_data/data
example_data/data

# Per-machine annotator config and outputs (see annotator/.gitignore too)
annotator/work/
annotator/weights/
annotator/annotator_config.json

# Masks and derived products generated by the tools
water_mask.png
# ...except the gold masks for the two bundled example scenes, so a fresh
# clone can run the training pipeline and reproduce its numbers without
# labelling first. `*` does not match `/`, and example_data/data is an
# ignored symlink git never descends into, so this cannot pull in the
# capture archive.
!example_data/*/water_mask.png
water_mask_auto.png
water_mask_thermal.png
tinysam_water_mask.png
water_mask_preview.jpg
_annotator_*.png
manifest.csv
dataset_provenance.csv
